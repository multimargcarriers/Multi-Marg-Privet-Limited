# ============================================================
# MULTIMARG CARRIERS - Frontend Environment Example
# ============================================================
# Copy this file to .env and fill in your values
# All Vite env variables must be prefixed with VITE_
# ============================================================

# Backend API URL
VITE_API_URL=http://localhost:5000/api

# Firebase Client SDK Config
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxx

# Cloudinary
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=multimarg_preset

# App Configuration
VITE_APP_NAME=Multimarg Carriers
VITE_APP_TAGLINE=Transport Management System